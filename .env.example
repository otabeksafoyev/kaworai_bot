# ──────────────────────────────────────────────────────────────────────────
#  kaworai_bot — muhit o'zgaruvchilari (environment variables).
#
#  Ushbu faylni `.env` nomi bilan nusxa oling va o'zingizning qiymatlaringizni
#  kiriting. `.env` fayli .gitignore bilan tashlab yuborilgan — hech qachon
#  repositoriyga kommit qilmang.
#
#  Ogohlantirish: barcha maxfiy qiymatlar (BOT_TOKEN, DATABASE_URL, CARD_NUMBER...)
#  *haqiqiy* ma'lumotlarni o'z ichiga oladi, shuning uchun .env faylini
#  xavfsiz saqlang va talab bo'lmagan serverlarga joylamang.
# ──────────────────────────────────────────────────────────────────────────

# === Botning asosiy sozlamalari ===
BOT_TOKEN=123456:AAA-bbb-ccc                  # @BotFather dan olingan token
BOT_USERNAME=kaworai_uz_bot                   # @ siz, `t.me/<username>` shaklida

# === Adminlar ===
# Bir nechta admin kerak bo'lsa, vergul bilan ajrating: `123,456,789`.
ADMIN_ID=123456789

# === Kanallar ===
# Bot foydalanuvchi obuna bo'lishi shart bo'lgan asosiy yangiliklar kanali.
NEWS_CHANNEL_ID=-1001234567890

# Pro foydalanuvchilar uchun yashirin kanal (anime qo'yiladigan joy).
SECRET_CHANNEL_ID=-1009876543210

# === Pro to'lov tizimi (Pro payment) ===
# Admin foydalanuvchilarga to'lov cheklari yuboriladigan yopiq kanal.
PAYMENT_CHANNEL_ID=-1001122334455

# To'lov uchun karta raqami — foydalanuvchilar shu kartaga o'tkazma qilishadi.
# Jamoat qo'llanma kartalari bo'lmasin; botda PII ochiqdan-ochiq ko'rsatiladi.
CARD_NUMBER=8600 0000 0000 0000

# Karta egasining ismi — foydalanuvchi sizni ishonchli deb bilishi uchun.
CARD_OWNER=Familiya Ism Otasining ismi

# Admin @username — to'lov tekshiruvida muammo bo'lsa foydalanuvchi murojaat
# qiladigan aloqa. @ belgisi shart emas (kiritsangiz ham xato bermaydi).
ADMIN_USERNAME=sizning_admin_username

# === Ma'lumotlar bazasi / keshlar ===
# PostgreSQL asynchpg URL'i. Format:
#   postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaworai

# Redis — aiogram FSM va throttling uchun.
REDIS_URL=redis://localhost:6379/0
